{
  "name": "dsh-client-ui-quota",
  "description": "Quota settings section and sidebar indicator for the DeepSeek Harness web client, reading the Host quota-monitor Remote namespace.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node esbuild.mjs",
    "test": "node test/unwrap-remote.mjs && node test/store-paths.mjs && node test/row-summary.mjs && node test/active-provider.mjs && node test/simulate.mjs && node test/real-mount.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "dsh-quota-monitor": "file:../../quota-monitor",
    "esbuild": "^0.24.2",
    "react": "^18.3.1",
    "typescript": "5.6"
  }
}
